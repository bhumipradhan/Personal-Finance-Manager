// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  moduleFormat="cjs"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  income
  expense
}

enum RecurrenceInterval {
  daily
  weekly
  monthly
  yearly
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  categoryId  String          @map("category_id")
  date        DateTime        @default(now())
  notes       String?
  isRecurring Boolean         @default(false) @map("is_recurring")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([date])
  @@map("transactions")
}

model Category {
  id        String          @id @default(uuid())
  name      String
  color     String?
  type      TransactionType
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at")

  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  @@unique([name, type])
  @@map("categories")
}

model Budget {
  id         String   @id @default(uuid())
  categoryId String   @map("category_id")
  amount     Decimal  @db.Decimal(12, 2)
  month      Int
  year       Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, month, year])
  @@map("budgets")
}

model SavingsGoal {
  id           String    @id @default(uuid())
  name         String
  targetAmount Decimal   @map("target_amount") @db.Decimal(12, 2)
  savedAmount  Decimal   @default(0) @map("saved_amount") @db.Decimal(12, 2)
  deadline     DateTime?
  completed    Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  contributions GoalContribution[]

  @@map("savings_goals")
}

model GoalContribution {
  id     String   @id @default(uuid())
  goalId String   @map("goal_id")
  amount Decimal  @db.Decimal(12, 2)
  date   DateTime @default(now())
  notes  String?

  goal SavingsGoal @relation(fields: [goalId], references: [id])

  @@index([goalId])
  @@map("goal_contributions")
}

model RecurringTransaction {
  id          String             @id @default(uuid())
  amount      Decimal            @db.Decimal(12, 2)
  type        TransactionType
  categoryId  String             @map("category_id")
  frequency   RecurrenceInterval
  nextDueDate DateTime           @map("next_due_date")
  notes       String?
  active      Boolean            @default(true)

  category Category @relation(fields: [categoryId], references: [id])

  @@map("recurring_transactions")
}
